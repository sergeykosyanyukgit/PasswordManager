<views:CaptureProtectedWindow x:Class="PasswordManager.App.Views.TerminalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PasswordManager.App.Views"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="SSH — PasswordManager" Width="1000" Height="680" MinWidth="640" MinHeight="420"
    WindowStartupLocation="CenterOwner">
    <Grid Background="#0B1020">
        <TextBlock x:Name="Status" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Connecting securely…" />
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
    </Grid>
</views:CaptureProtectedWindow>


<views:CaptureProtectedWindow x:Class="PasswordManager.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PasswordManager.App.Views"
    xmlns:vm="clr-namespace:PasswordManager.App.ViewModels"
    xmlns:core="clr-namespace:PasswordManager.Core.Models;assembly=PasswordManager.Core"
    xmlns:infra="clr-namespace:PasswordManager.App.Infrastructure"
    Title="{Binding [AppTitle], Source={x:Static infra:Localizer.Instance}}"
    Width="1280" Height="760" MinWidth="960" MinHeight="600"
    WindowStartupLocation="CenterScreen" AllowDrop="True"
    Drop="WindowDrop" PreviewKeyDown="WindowPreviewKeyDown"
    PreviewMouseMove="NotifyActivity">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="PlainCustomFieldTemplate">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <DataTemplate x:Key="SecretCustomFieldTemplate">
            <PasswordBox infra:PasswordBoxAssistant.BindPassword="True"
                         infra:PasswordBoxAssistant.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding [Open], Source={x:Static infra:Localizer.Instance}}" Click="OpenClick" />
            <MenuItem Header="{Binding [Create], Source={x:Static infra:Localizer.Instance}}" Click="CreateClick" />
            <MenuItem Header="{Binding [SaveAs], Source={x:Static infra:Localizer.Instance}}" Click="SaveAsClick" />
            <MenuItem Header="{Binding [ChangeMasterPassword], Source={x:Static infra:Localizer.Instance}}" Click="ChangeMasterPasswordClick" />
            <Separator />
            <MenuItem Header="{Binding [LockAll], Source={x:Static infra:Localizer.Instance}}" Click="LockAllClick" />
            <MenuItem Header="{Binding [Language], Source={x:Static infra:Localizer.Instance}}">
                <MenuItem Header="Русский" Tag="ru" Click="LanguageClick" />
                <MenuItem Header="English" Tag="en" Click="LanguageClick" />
            </MenuItem>
        </Menu>

        <Grid x:Name="EmptyState" Background="#F8FAFC">
            <TextBlock Text="{Binding [NoVault], Source={x:Static infra:Localizer.Instance}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#475569" />
        </Grid>

        <TabControl x:Name="VaultTabs" ItemsSource="{Binding Vaults}" SelectedItem="{Binding SelectedVault}"
                    Visibility="Collapsed">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" Margin="8,2" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:VaultTabViewModel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding [AddFolder], Source={x:Static infra:Localizer.Instance}}" Click="AddFolderClick" />
                            <Button Grid.Column="1" Content="{Binding [AddRecord], Source={x:Static infra:Localizer.Instance}}" Click="AddRecordClick" />
                            <ToggleButton Grid.Column="2" Margin="3" Padding="10,5" Content="{Binding [RecycleBin], Source={x:Static infra:Localizer.Instance}}"
                                          IsChecked="{Binding ShowRecycleBin}" />
                            <Button Grid.Column="3" Content="{Binding [Delete], Source={x:Static infra:Localizer.Instance}}" Click="DeleteRecordClick" />
                            <TextBox Grid.Column="4" Margin="12,3,3,3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding [Search], Source={x:Static infra:Localizer.Instance}}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" MinWidth="170" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="360" MinWidth="240" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" MinWidth="320" />
                            </Grid.ColumnDefinitions>

                            <TreeView Grid.Column="0" ItemsSource="{Binding FolderRoots}" SelectedItemChanged="FolderSelected"
                                      AllowDrop="True" Drop="FolderDrop" KeyDown="FolderKeyDown" Background="#F8FAFC">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename / Переименовать" Click="RenameFolderClick" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Breadcrumb}" FontWeight="SemiBold" Padding="8" Background="#EFF6FF" />
                                <DataGrid ItemsSource="{Binding VisibleRecords}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                          MouseMove="RecordMouseMove">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

                            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Padding="14">
                                <StackPanel DataContext="{Binding Draft}">
                                    <TextBlock Text="{Binding [Name], Source={x:Static infra:Localizer.Instance}}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding [Type], Source={x:Static infra:Localizer.Instance}}" />
                                    <ComboBox ItemsSource="{Binding DataContext.RecordTypes, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                              SelectedItem="{Binding Type}" Margin="0,3" />
                                    <TextBlock Text="{Binding [UserName], Source={x:Static infra:Localizer.Instance}}" />
                                    <TextBox Text="{Binding UserName}" />
                                    <TextBlock Text="{Binding [Email], Source={x:Static infra:Localizer.Instance}}" />
                                    <TextBox Text="{Binding Email}" />
                                    <TextBlock Text="{Binding [Password], Source={x:Static infra:Localizer.Instance}}" />
                                    <PasswordBox infra:PasswordBoxAssistant.BindPassword="True"
                                                 infra:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <WrapPanel>
                                        <Button Content="{Binding [Generate], Source={x:Static infra:Localizer.Instance}}" Click="GeneratePasswordClick" />
                                        <Button Content="Passphrase" Click="GeneratePassphraseClick" />
                                        <Button Content="{Binding [CheckPassword], Source={x:Static infra:Localizer.Instance}}" Click="CheckPasswordClick" />
                                        <Button Content="{Binding [Copy], Source={x:Static infra:Localizer.Instance}}" Click="CopyPasswordClick" />
                                    </WrapPanel>
                                    <Border Background="#FEE2E2" Padding="8" Margin="0,6" Visibility="{Binding IsCompromised, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{Binding BreachMessage}" Foreground="#991B1B" FontWeight="Bold" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding BreachMessage}" Foreground="#475569" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [Url], Source={x:Static infra:Localizer.Instance}}" />
                                    <TextBox Text="{Binding Url}" />
                                    <TextBlock Text="{Binding [Notes], Source={x:Static infra:Localizer.Instance}}" />
                                    <TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="110" VerticalScrollBarVisibility="Auto" />
                                    <Expander Header="SSH" IsExpanded="True" Visibility="{Binding IsSsh, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Host" />
                                            <TextBox Text="{Binding Ssh.Host}" />
                                            <TextBlock Text="Port" />
                                            <TextBox Text="{Binding Ssh.Port}" />
                                            <TextBlock Text="SSH user" />
                                            <TextBox Text="{Binding Ssh.UserName}" />
                                            <TextBlock Text="Authentication" />
                                            <ComboBox ItemsSource="{Binding SshAuthenticationKinds}" SelectedItem="{Binding Ssh.AuthenticationKind}" />
                                            <TextBlock Text="SSH password" />
                                            <PasswordBox infra:PasswordBoxAssistant.BindPassword="True"
                                                         infra:PasswordBoxAssistant.BoundPassword="{Binding Ssh.Password, Mode=TwoWay}" />
                                            <TextBlock Text="Private key (PEM/OpenSSH)" />
                                            <TextBox Text="{Binding Ssh.PrivateKeyPem}" AcceptsReturn="True" MinHeight="80" />
                                            <TextBlock Text="Private-key passphrase" />
                                            <PasswordBox infra:PasswordBoxAssistant.BindPassword="True"
                                                         infra:PasswordBoxAssistant.BoundPassword="{Binding Ssh.PrivateKeyPassphrase, Mode=TwoWay}" />
                                            <TextBlock Text="Pinned host key" />
                                            <TextBox Text="{Binding Ssh.HostKeySha256}" IsReadOnly="True" />
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Custom fields / Пользовательские поля" IsExpanded="False">
                                        <StackPanel Margin="8">
                                            <ItemsControl ItemsSource="{Binding CustomFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding Name}" />
                                                            <ContentControl Grid.Column="1" Content="{Binding}">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource PlainCustomFieldTemplate}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource SecretCustomFieldTemplate}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                            <CheckBox Grid.Column="2" Content="Secret" IsChecked="{Binding IsSecret}" VerticalAlignment="Center" Margin="6" />
                                                            <Button Grid.Column="3" Content="×" Click="RemoveCustomFieldClick" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="+ Field" HorizontalAlignment="Left" Click="AddCustomFieldClick" />
                                        </StackPanel>
                                    </Expander>
                                    <WrapPanel>
                                        <Button Content="{Binding [Save], Source={x:Static infra:Localizer.Instance}}" Click="SaveRecordClick" />
                                        <Button Content="{Binding [Cancel], Source={x:Static infra:Localizer.Instance}}" Click="CancelRecordClick" />
                                        <Button Content="{Binding [ConnectSsh], Source={x:Static infra:Localizer.Instance}}" Click="ConnectSshClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</views:CaptureProtectedWindow>

<views:CaptureProtectedWindow x:Class="PasswordManager.App.Views.PasswordPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PasswordManager.App.Views"
    Title="PasswordManager" Width="430" SizeToContent="Height" WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Margin="0,14,0,2" Text="{Binding [MasterPassword], Source={x:Static local:Localizer.Instance}}"
                   xmlns:local="clr-namespace:PasswordManager.App.Infrastructure" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" MinWidth="360" />
        <StackPanel x:Name="ConfirmationPanel" Grid.Row="3" Visibility="Collapsed">
            <TextBlock Margin="0,8,0,2" Text="{Binding [ConfirmPassword], Source={x:Static local:Localizer.Instance}}"
                       xmlns:local="clr-namespace:PasswordManager.App.Infrastructure" />
            <PasswordBox x:Name="ConfirmationInput" />
            <TextBlock x:Name="PolicyMessage" Margin="0,8,0,0" Foreground="#B91C1C" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AcceptButton" IsDefault="True" Click="AcceptClick" />
            <Button Content="{Binding [Cancel], Source={x:Static local:Localizer.Instance}}" IsCancel="True"
                    xmlns:local="clr-namespace:PasswordManager.App.Infrastructure" />
        </StackPanel>
    </Grid>
</views:CaptureProtectedWindow>


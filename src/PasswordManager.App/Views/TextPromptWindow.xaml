<views:CaptureProtectedWindow x:Class="PasswordManager.App.Views.TextPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PasswordManager.App.Views"
    Title="PasswordManager" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="Input" Margin="0,10,0,0" MaxLength="512" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Click="AcceptClick" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</views:CaptureProtectedWindow>

